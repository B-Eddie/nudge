{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "positioner:default",
    "autostart:default",
    "allow-set-click-through",
    "allow-settings",
    "allow-activity",
    "allow-reminder",
    "allow-pending-notes",
    "allow-frontmost-app",
    "allow-input-monitor",
    "allow-invalidate-overlay",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-set-focus"
  ]
}
